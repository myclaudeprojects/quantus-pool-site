# Server
PORT=3847
HOST=0.0.0.0
NODE_ENV=development

# SQLite path (absolute or relative to project root)
DATABASE_PATH=./data/pool.sqlite

# Operator wormhole — all QTC from one-click miner lands here until claims
OPERATOR_WORMHOLE=qzmFDWnWRLygXLQMFU5GrFohBQe4gtFSp5Q45G3tXgn3P9WsQ

# Download signing (change in production)
DOWNLOAD_SECRET=change-me-to-a-long-random-string
DOWNLOAD_TTL_SECONDS=300

# Path to Windows zip (default: public/releases/QuantusOneClick-Windows.zip)
RELEASE_ZIP_PATH=./public/releases/QuantusOneClick-Windows.zip

# --- Argus token for pool share % only (NOT a download paywall) ---
# Download is always open. TOKEN_ADDRESS drives balance → share weight.
# Pre-launch: leave TOKEN_ADDRESS empty (stub balances for registered miners).
TOKEN_ADDRESS=
TOKEN_CHAIN_RPC=
MIN_HOLD=1
# Deprecated / ignored as a gate — download is always open
PRE_TOKEN_OPEN_DOWNLOAD=true

# Claims locked until operator flips this after token launch + attribution ready
CLAIMS_OPEN=false

# --- Pool share economics ---
# Holding >= MIN_HOLD → base share proportional to balance (linear).
# Connected miner (heartbeat in window) → weight *= CONNECTED_MULTIPLIER
CONNECTED_MULTIPLIER=1.5
CONNECTED_WINDOW_MINUTES=15
# Pre-token stub balance for registered miner wallets (TOKEN_ADDRESS empty)
STUB_TOKEN_BALANCE=1
# Demo pool QTC accrual used for provisional reward estimates
DEMO_POOL_ACCRUAL_QTC=10

# CoinGecko — Quantus QTC id is "quantus" (https://www.coingecko.com/en/coins/quantus)
COINGECKO_ID=quantus
PRICE_CACHE_SECONDS=60

# Optional: CORS origin (blank = reflect request origin in dev)
CORS_ORIGIN=

# --- Quantus mainnet block feed (explorer indexer) ---
QUANTUS_GRAPHQL_URL=https://sub2.quantus.com/v1/graphql
QUANTUS_POLL_MS=4000
QUANTUS_GRAPHQL_TIMEOUT_MS=8000
QUANTUS_BLOCK_LIMIT=12
QUANTUS_PROVISIONAL_BLOCK_MS=12000
COINGECKO_URL=https://www.coingecko.com/en/coins/quantus
