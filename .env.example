# Server
PORT=3847
HOST=0.0.0.0
NODE_ENV=development

# SQLite path (absolute or relative to project root)
DATABASE_PATH=./data/pool.sqlite

# Operator wormhole — all QTC from one-click miner lands here until claims
OPERATOR_WORMHOLE=qzmFDWnWRLygXLQMFU5GrFohBQe4gtFSp5Q45G3tXgn3P9WsQ

# Download signing (change in production)
DOWNLOAD_SECRET=change-me-to-a-long-random-string
DOWNLOAD_TTL_SECONDS=300

# Path to Windows zip (default: public/releases/QuantusOneClick-Windows.zip)
RELEASE_ZIP_PATH=./public/releases/QuantusOneClick-Windows.zip

# --- Argus / Arc QTC for pool share % + Buy QTC CTA (NOT a download paywall) ---
# Download is always open. TOKEN_ADDRESS drives balance → share weight AND Buy button.
# Pre-launch: leave TOKEN_ADDRESS empty → Buy QTC button is hidden; stub balances for registered miners.
# When live: set TOKEN_ADDRESS to the Arc contract address → Buy links to https://argus.world/token/<TOKEN_ADDRESS>
# Optional override full URL (else derived from TOKEN_ADDRESS):
# ARGUS_TOKEN_URL=https://argus.world/token/0x...
TOKEN_ADDRESS=
ARGUS_TOKEN_URL=
TOKEN_CHAIN_RPC=
MIN_HOLD=1
# Deprecated / ignored as a gate — download is always open
PRE_TOKEN_OPEN_DOWNLOAD=true

# Claims locked until operator flips this after token launch + attribution ready
CLAIMS_OPEN=false

# --- Pool share economics ---
# Holding >= MIN_HOLD → base share proportional to balance (linear).
# Connected miner (heartbeat in window) → weight *= CONNECTED_MULTIPLIER
CONNECTED_MULTIPLIER=1.5
CONNECTED_WINDOW_MINUTES=15

# --- Locked share curve (aggressive per-million + mining gate) ---
# weight = 0 if not mining; else n=floor(H/1e6), rem=H%1e6,
#   weight = Σ_{k=1..n}(1e6 · k^p) + rem · (n+1)^p   (p = SHARE_CURVE_POWER)
# Claim % = share of pool mining pot (not % of 21M L1 max)
SHARE_CURVE=per_million_aggressive
SHARE_CURVE_POWER=1.5
LAUNCH_TOTAL_SUPPLY=1000000000
L1_MAX_SUPPLY_QTC=21000000
LAUNCH_HOUSE_BUY_TOKENS=5000000

# Pre-token stub balance for registered miner wallets (TOKEN_ADDRESS empty)
STUB_TOKEN_BALANCE=1
# Demo pool QTC accrual used for provisional reward estimates
DEMO_POOL_ACCRUAL_QTC=10

# CoinGecko — Quantus QTC id is "quantus" (https://www.coingecko.com/en/coins/quantus)
COINGECKO_ID=quantus
PRICE_CACHE_SECONDS=60

# Optional: CORS origin (blank = reflect request origin in dev)
CORS_ORIGIN=

# --- Quantus mainnet block feed (explorer indexer) ---
QUANTUS_GRAPHQL_URL=https://sub2.quantus.com/v1/graphql
QUANTUS_POLL_MS=4000
QUANTUS_GRAPHQL_TIMEOUT_MS=8000
QUANTUS_BLOCK_LIMIT=12
QUANTUS_PROVISIONAL_BLOCK_MS=12000
COINGECKO_URL=https://www.coingecko.com/en/coins/quantus

# --- Operator rig (REAL hashrate only — no fake MH/s) ---
# Active hashrate = OPERATOR_HASHRATE_HS + sum(connected miners with recent heartbeat).
# Probe Quantus miner Prometheus on the mining PC:
#   curl -s http://127.0.0.1:9900/metrics | grep '^miner_hash_rate '
# Hasura https://sub2.quantus.com/v1/graphql does NOT expose per-miner hashrate.
# Wormhole is reward destination only — not a hashrate identity.
SEED_OPERATOR_MINER=true
OPERATOR_HASHRATE_HS=
# Optional: poll Prometheus directly (must be reachable from the server):
# OPERATOR_METRICS_URL=http://127.0.0.1:9900/metrics
# OPERATOR_METRICS_POLL_MS=60000
SEED_OPERATOR_LABEL=operator-rig
SEED_OPERATOR_MINER_ID=operator-seed-001
# SEED_OPERATOR_WALLET defaults to OPERATOR_WORMHOLE
SEED_OPERATOR_TOUCH_MS=60000

